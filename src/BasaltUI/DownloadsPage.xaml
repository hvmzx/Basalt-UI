<!--
  DownloadsPage.xaml — the downloads centre: everything this app has pulled or is pulling, the
  current ones with their speed and progress, the past ones below. A download belongs to the app,
  never to the page that started it, so this list is the one honest place for it.
-->
<UserControl x:Class="BasaltUI.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:BasaltUI.Core"
             xmlns:cv="clr-namespace:BasaltUI.Converters"
             Background="{x:Null}"
             Foreground="{StaticResource TextPrimary}"
             FontFamily="{StaticResource FontText}" FontSize="13"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ the row of actions ============ -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="20,0,20,0">
            <TextBlock DockPanel.Dock="Left" x:Name="CountText" Text="" Style="{StaticResource Label}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" />
            <Button DockPanel.Dock="Right" Content="Open models folder" Click="OpenFolder_Click" />
            <Button DockPanel.Dock="Right" Content="Clear finished" Click="ClearHistory_Click" Margin="0,0,8,0"
                    ToolTip="Take the finished and failed ones out of the list; nothing on disk is deleted" />
        </DockPanel>

        <!-- ============ the list ============ -->
        <Border Grid.Row="1" Margin="20,4,20,16" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListBox x:Name="DownList" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,11" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:DownloadItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Repo}" Style="{StaticResource Label}"
                                                   Foreground="{DynamicResource TextFaint}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="1"
                                                 Value="{Binding Fraction, Mode=OneWay}" />
                                    <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Line}" Style="{StaticResource Label}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="560" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}"
                                                   Style="{StaticResource Label}" Foreground="{DynamicResource TextFaint}" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Pause" Click="Pause_Click" Tag="{Binding}"
                                            Margin="0,0,6,0" MinWidth="64"
                                            Visibility="{Binding Active, Converter={x:Static cv:BoolToVisibility.Instance}}"
                                            ToolTip="Stop the transfer — it carries on from where the bytes stopped" />
                                    <Button Content="Resume" Click="Resume_Click" Tag="{Binding}"
                                            Margin="0,0,6,0" MinWidth="64"
                                            Visibility="{Binding CanResume, Converter={x:Static cv:BoolToVisibility.Instance}}"
                                            ToolTip="Carry on from where the bytes stopped" />
                                    <Button Content="Remove" Click="Remove_Click" Tag="{Binding}" MinWidth="64"
                                            Visibility="{Binding IsDoneOrFailed, Converter={x:Static cv:BoolToVisibility.Instance}}"
                                            ToolTip="Take it out of the list; the file it finished stays on disk" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock HorizontalAlignment="Center"
                           Text="nothing here yet — Discover more… in the Models card is where downloads start">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EmptyNote}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=DownList, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
