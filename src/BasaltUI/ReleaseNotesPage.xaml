<!--
  ReleaseNotesPage.xaml — a release's notes as a page over the dashboard, the way Settings is. They come
  from the releases API as markdown; a small renderer turns the shapes a changelog actually uses —
  headings, bullets, inline code — into styled text, and the full page stays one click away on GitHub.
-->
<UserControl x:Class="BasaltUI.ReleaseNotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimary}">

    <Grid Margin="20,14,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the release, named, and the way out to the full page -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,2,0,12">
            <Button DockPanel.Dock="Right" x:Name="GitHubButton" Style="{StaticResource GhostButton}"
                    Content="Open on GitHub" Click="GitHub_Click" VerticalAlignment="Center"
                    ToolTip="The full release page in your browser" />
            <TextBlock x:Name="ReleaseTitle" Style="{StaticResource Label}" FontSize="12.5"
                       VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,16" Style="{StaticResource Card}" Padding="24,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NotesPanel" MaxWidth="700" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
