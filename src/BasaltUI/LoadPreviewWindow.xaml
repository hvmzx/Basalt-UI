<Window x:Class="BasaltUI.LoadPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:BasaltUI.Controls"
        Title="Config preview" Width="720" Height="640" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None"
        Background="{DynamicResource Window}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontText}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8,8,8,8" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <DockPanel Margin="20,14">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock x:Name="TitleText" Style="{StaticResource Big}" FontSize="16" />
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        DockPanel.Dock="Right" ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </DockPanel>
            <TextBlock x:Name="Verdict" Style="{StaticResource Label}" DockPanel.Dock="Top"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Label}" DockPanel.Dock="Top" Margin="0,4,0,10"
                       Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                       Text="Estimated from each file's section table and the memory free right now. Anything that does not fit in VRAM or RAM streams from the SSD. The engine settles the exact split when it loads." />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="ModelRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <c:Bar Caption="VRAM" Height="32" Margin="0,8,0,0" Calm="True"
                                               Fraction="{Binding VramFraction}" ValueText="{Binding VramText}" />
                                        <c:Bar Caption="RAM" Height="32" Margin="0,6,0,0" Calm="True"
                                               Fraction="{Binding RamFraction}" ValueText="{Binding RamText}" />
                                        <c:Bar Caption="SSD" Height="32" Margin="0,6,0,0" Calm="True"
                                               Fraction="{Binding SsdFraction}" ValueText="{Binding SsdText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="All models in this config" Style="{StaticResource CardTitle}" />
                            <c:Bar Caption="VRAM total" Height="32" Margin="0,8,0,0"
                                   Fraction="{Binding TotalVramFraction}" ValueText="{Binding TotalVramText}" />
                            <c:Bar Caption="RAM total" Height="32" Margin="0,6,0,0" Calm="True"
                                   Fraction="{Binding TotalRamFraction}" ValueText="{Binding TotalRamText}" />
                            <c:Bar Caption="from SSD" Height="32" Margin="0,6,0,0" Calm="True"
                                   Fraction="{Binding TotalSsdFraction}" ValueText="{Binding TotalSsdText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
