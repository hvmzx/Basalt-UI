<!--
  Light tokens: the same roles as Dark.xaml, values for a light room. Styles never name a theme —
  they read these by DynamicResource, so which of the two files is merged decides everything.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Window" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHi" Color="#F1F3F6" />
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHover" Color="#F1F3F6" />
    <SolidColorBrush x:Key="Field" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Line" Color="#E5E8EC" />
    <SolidColorBrush x:Key="LineHi" Color="#C9CFD7" />

    <SolidColorBrush x:Key="TextPrimary" Color="#191B1F" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5A6270" />
    <SolidColorBrush x:Key="TextFaint" Color="#9BA1AC" />

    <SolidColorBrush x:Key="Accent" Color="#1667D9" />
    <SolidColorBrush x:Key="AccentHover" Color="#3D82E8" />
    <SolidColorBrush x:Key="AccentDark" Color="#0E55B8" />
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E7F0FC" />

    <SolidColorBrush x:Key="Slate" Color="#5D6F8C" />

    <SolidColorBrush x:Key="Warn" Color="#8F6400" />
    <SolidColorBrush x:Key="Bad" Color="#C0392F" />
    <SolidColorBrush x:Key="Good" Color="#157A44" />
    <SolidColorBrush x:Key="RunBg" Color="#E4F3EA" />

    <SolidColorBrush x:Key="ReadyBg" Color="#E4F4EA" />
    <SolidColorBrush x:Key="BusyBg" Color="#E7F0FC" />
    <SolidColorBrush x:Key="WaitBg" Color="#F7EEDA" />
    <SolidColorBrush x:Key="StopBg" Color="#F9E6E4" />

    <SolidColorBrush x:Key="DangerBg" Color="#FAE9E8" />
    <SolidColorBrush x:Key="DangerBgHover" Color="#F4D9D7" />
    <SolidColorBrush x:Key="DangerLine" Color="#EFC8C6" />
    <SolidColorBrush x:Key="DangerText" Color="#A2312B" />

</ResourceDictionary>
