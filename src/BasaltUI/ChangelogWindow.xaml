<Window x:Class="BasaltUI.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:BasaltUI"
        Title="What changed" Width="760" Height="620"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Window}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource FontText}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="18,12,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <pages:ReleaseNotesPage x:Name="Notes" />
        <Button Grid.Row="1" Content="Close" HorizontalAlignment="Right" MinWidth="90"
                Margin="0,10,0,0" Click="Close_Click" />
    </Grid>
</Window>
