<Window x:Class="BasaltUI.ModelsBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:cv="clr-namespace:BasaltUI.Converters"
        xmlns:c="clr-namespace:BasaltUI.Controls"
        Title="Find a model — Hugging Face"
        Width="1060" Height="680" MinWidth="740" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource Window}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontText}" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="8,8,8,8" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Done" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="{DynamicResource Good}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,0,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ what we are looking for, and where it lands ============ -->
        <Grid Grid.Row="0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                    <TextBox x:Name="QueryBox" KeyDown="Query_KeyDown" Padding="11,6,10,6"
                             AutomationProperties.Name="Search Hugging Face" />
                <Button x:Name="SearchButton" Grid.Column="2" Content="Search" Click="Search_Click"
                        Style="{StaticResource AccentButton}" MinWidth="84" MinHeight="34"
                        ToolTip="Ask Hugging Face for repos matching the phrase" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Left" Margin="24,0,0,0">
                <TextBlock Text="into" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <TextBlock x:Name="FolderText" Style="{StaticResource Mono}" VerticalAlignment="Center"
                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                <Button x:Name="OpenFolderButton" Style="{StaticResource GhostButton}" Content="Open folder"
                        Click="OpenFolder_Click" Margin="12,0,0,0" />
                <Button x:Name="ChangeFolderButton" Style="{StaticResource GhostButton}" Content="Change in Settings…"
                        Click="ChangeFolder_Click" Margin="4,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        ToolTip="Close" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ============ repos ============ -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" x:Name="SearchNote" Style="{StaticResource Label}"
                           Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Type what you are after — a name, a quant, “basalt” — and press Enter." />
                <TextBlock DockPanel.Dock="Bottom" x:Name="SearchFoot" Style="{StaticResource Label}"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ElementName=ReposList, Path=HasItems, Converter={x:Static cv:BoolToVisibility.Instance}}" />
                <Grid>
                    <ListBox x:Name="ReposList" SelectionChanged="Repo_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceHi}" CornerRadius="9" Padding="12,9">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <c:Badge DockPanel.Dock="Left" Width="24" Height="24" Margin="0,1,8,0"
                                                     VerticalAlignment="Top"
                                                     Identity="{Binding Badge}"
                                                     Visibility="{Binding HasBadge, Converter={x:Static cv:BoolToVisibility.Instance}}"
                                                     ToolTip="{Binding Badge.Tip}" />
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}"
                                                    CornerRadius="4" Height="18" Padding="0" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Official, Converter={x:Static cv:BoolToVisibility.Instance}}">
                                                <TextBlock Text="official" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                           Margin="7,-1,7,0" />
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LikeMark}"
                                                       Style="{StaticResource Label}" VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DownloadMark}"
                                                       Style="{StaticResource Label}" Foreground="{DynamicResource TextFaint}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold" FontSize="12.5" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Owner}" Style="{StaticResource Label}"
                                                   TextTrimming="CharacterEllipsis" FontSize="11" />
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,5,0,0"
                                                      Visibility="{Binding HasTags, Converter={x:Static cv:BoolToVisibility.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                            Margin="0,0,5,4">
                                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Style="{StaticResource EmptyNote}"
                               Text="{Binding Text, ElementName=SearchFoot}"
                               Visibility="{Binding ElementName=ReposList, Path=HasItems,
                                 Converter={x:Static cv:NotBoolToVisibility.Instance}}" />
                </Grid>
            </DockPanel>

            <!-- ============ files of the selected repo ============ -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="RepoTitle" Text="a repo on Hugging Face" FontWeight="SemiBold"
                                       FontSize="13.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="RepoFacts" Style="{StaticResource Label}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="OpenRepoButton" Content="Open on Hugging Face" Click="OpenRepo_Click"
                                    HorizontalAlignment="Right" IsEnabled="False" />
                            <Button x:Name="SetModelButton" Content="Copy the folder path" Click="SetModel_Click"
                                    HorizontalAlignment="Right" Margin="0,6,0,0" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="DownloadAllButton" Content="Download the model files here"
                            Style="{StaticResource AccentButton}" Click="DownloadAll_Click" IsEnabled="False" />
                    <TextBlock x:Name="PickNote" Style="{StaticResource Label}" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="430"
                               Visibility="{Binding ElementName=FilesList, Path=HasItems,
                                 Converter={x:Static cv:BoolToVisibility.Instance}}" />
                </StackPanel>

                <Border x:Name="PreviewCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,12"
                        Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="load preview — how it would sit on this machine"
                                       Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <TextBlock x:Name="PreviewVerdict" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <StackPanel x:Name="PreviewRows" Margin="0,8,0,0" />
                        <TextBlock x:Name="PreviewNote" Style="{StaticResource Label}"
                                   Foreground="{DynamicResource TextFaint}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ListBox x:Name="FilesList" HorizontalContentAlignment="Stretch"
                                 SelectionChanged="Files_SelectionChanged"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="14,9" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Where}" Style="{StaticResource Label}"
                                                       Foreground="{DynamicResource TextFaint}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Done}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0"
                                                   FontFamily="{StaticResource FontMono}" FontSize="11.5" />
                                        <Button Grid.Column="3" Content="Download" Margin="12,0,0,0" Padding="10,4"
                                                MinHeight="26" Click="DownloadOne_Click" Tag="{Binding}"
                                                IsEnabled="{Binding CanStart}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource EmptyNote}"
                                   Text="{Binding Text, ElementName=PickNote}"
                                   Visibility="{Binding ElementName=FilesList, Path=HasItems,
                                     Converter={x:Static cv:NotBoolToVisibility.Instance}}" />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>

        <!-- ============ the transfer ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,14,0,0">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" x:Name="JobText" Text="nothing on its way"
                               TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" x:Name="SpeedText" Style="{StaticResource Label}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" x:Name="PauseButton" Content="Pause" Click="PauseTransfer_Click"
                            Visibility="Collapsed"
                            ToolTip="Only the user stops a download — this is that button. It carries on from where the bytes stopped." />
                </DockPanel>
                <ProgressBar x:Name="JobBar" Height="5" Margin="0,9,0,0" Minimum="0" Maximum="1" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
