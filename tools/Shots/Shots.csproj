<Project Sdk="Microsoft.NET.Sdk">

  <!-- Screenshots without a screen: builds the app's real windows off-screen and writes them to PNG, so a
       design pass can be reviewed as images instead of by launching the app and describing what appeared.
       It links against the shipping assembly, so it draws exactly what the app draws — same theme, same
       controls, same bindings. Nothing here is referenced by the app itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>basalt-shots</AssemblyName>
    <RootNamespace>Shots</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BasaltUI\BasaltUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- only a fallback: if the compiled theme cannot be reached through its pack uri, the very same files are
         read from disk next to the exe. They are copied, never duplicated. -->
    <None Include="..\..\src\BasaltUI\Themes\*.xaml" Link="theme\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
